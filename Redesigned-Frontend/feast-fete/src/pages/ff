                }}
            >

                <h1
                    style={{
                        fontSize: "52px",
                        color: "#2b1408"
                    }}
                >
                    My Bookings
                </h1>

                <p
                    style={{
                        color: "#666",
                        marginTop: "10px"
                    }}
                >
                    Your Catering Booking History
                </p>

            </div>

            {/* BOOKINGS */}
            <div
                style={{
                    display: "grid",
                    gap: "30px"
                }}
            >

                {
                    bookings.map((booking) => (

                        <div
                            key={booking.id}
                            style={{
                                background: "#fff",
                                padding: "35px",
                                borderRadius: "24px",
                                boxShadow:
                                    "0 10px 30px rgba(0,0,0,0.08)"
                            }}
                        >

                            <div
                                style={{
                                    display: "flex",
                                    justifyContent: "space-between",
                                    alignItems: "center",
                                    flexWrap: "wrap",
                                    gap: "20px"
                                }}
                            >

                                <div>

                                    <h2
                                        style={{
                                            color: "#2b1408",
                                            marginBottom: "12px"
                                        }}
                                    >
                                        {booking.organizerEmail}
                                    </h2>

                                    <p
                                        style={{
                                            marginBottom: "8px"
                                        }}
                                    >
                                        📅 Event Date :
                                        {" "}
                                        {booking.eventDate}
                                    </p>

                                    <p
                                        style={{
                                            marginBottom: "8px"
